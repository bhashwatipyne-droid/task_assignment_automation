# Copy to .env and fill in. Never commit .env or auth_info*/ (WhatsApp session).

# --- MongoDB (same Atlas cluster / database the PMT backend uses) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB=pmt

# --- WhatsApp groups / people ---
ALLOWED_GROUP_NAMES=Content Team,Design Team,Animation Team
# Comma-separated WhatsApp JIDs of managers whose tasklists are processed
MANAGER_JIDS=
# Poster phone -> PMT user name, so the task card says who assigned it.
# Last 10 digits of the number. Example: 9876543210=Vanshika Shah,9123456780=Sakshi Agrawal
MANAGER_MAP=
ASSIGNEES=
KEYWORDS=content,design,animation,tasklist

# --- Behaviour ---
# true = run matching and print what WOULD be written; nothing is saved
DRY_RUN=false
# Legacy `tasks` collection (the old listener output). Off: PMT reads tasklist_items.
WRITE_TASKS=false
# Optional alternative lexicon snapshot (default: ./lexicon.json)
# LEXICON_FILE=
PORT=3000
# Legacy n8n forwarding, not needed any more
FORWARD_TO_N8N=false

# Password for the /qr page that shows the WhatsApp link QR as an image (>= 24 chars).
# Set it only while linking; remove it afterwards. Use any username on the login prompt.
QR_PAGE_TOKEN=
